# Copy to .env and edit. Every value is optional; these are the defaults.

# ollama | openai_compat
ASKSQL_PROVIDER=ollama
# Use qwen2.5-coder:3b on a machine with 8 GB of RAM.
ASKSQL_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434
# ASKSQL_DB=data/taxi.db
# ASKSQL_HOME=/absolute/path/to/project  # defaults to the current directory

# Only for ASKSQL_PROVIDER=openai_compat. Never commit a real key.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
